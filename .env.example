# Server-only (configure in Netlify; never prefix secrets with VITE_)
DATABASE_URL=
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_EMAIL_FROM=LexAMS <auth@your-domain.example>
APP_URL=https://your-lexams-domain.example

# Resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Modem Pay
MODEM_PAY_API_KEY=
MODEM_PAY_WEBHOOK_SECRET=
# Optional when Modem Pay supplies a distinct merchant signing secret.
MODEM_PAY_MERCHANT_SECRET_KEY=

# Browser-safe
VITE_APP_NAME=LexAMS
